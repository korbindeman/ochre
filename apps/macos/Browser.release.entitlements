<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Host app, Developer ID, no provisioning profile (ADR-0070). Full hardened
     runtime (WebKit needs no JIT or library-validation exceptions, ADR-0072),
     plus the device entitlements hardened runtime requires before TCC will
     even prompt (mic, camera, Bluetooth, location). No restricted
     entitlements: without an embedded profile AMFI kills the app at launch if
     it carries com.apple.developer.*. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
