<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Chromium WebAuthn keychain groups (empty-team and TEAMID forms).
     Do not pass this file to ad-hoc codesign: keychain-access-groups is
     restricted and AMFI SIGKILLs (CRASH-0004 / ADR-0062). Developer ID
     signing uses Browser.signed.entitlements / Browser.production.entitlements. -->
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>.org.chromium.Chromium.webauthn</string>
		<string>$(AppIdentifierPrefix)org.chromium.Chromium.webauthn</string>
	</array>
</dict>
</plist>
